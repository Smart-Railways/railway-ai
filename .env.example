# Railway-AI ML Service environment configuration
# Copy to .env and modify as needed. No secrets should be committed.

# Server host and port configuration
# When starting via `python -m src.api.main`, these variables control the bind address and port.
# When starting via `uvicorn src.api.main:app`, use CLI flags `--host` and `--port`.
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# Comma-separated list of allowed CORS origins (CORS is disabled by default if empty).
# Wildcard '*' is never enabled by default.
# Example: ML_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ML_CORS_ORIGINS=
