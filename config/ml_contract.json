{
  "version": "0.1.0",
  "input": {
    "asset_id": "string",
    "section_id": "string",
    "snapshot_date": "YYYY-MM-DD",
    "condition_score": "number",
    "asset_age_years": "number",
    "criticality": "number",
    "usage_factor": "number",
    "weather_stress": "number",
    "historical_failure_count": "number",
    "historical_downtime_hours": "number",
    "days_since_last_failure": "number"
  },
  "output": {
    "failure_probability": "number",
    "maintenance_priority_score": "number",
    "priority_category": "LOW|MEDIUM|HIGH|CRITICAL",
    "recommended_block": "string|null",
    "predicted_delay_minutes": "number",
    "confidence": "number"
  },
  "railkit_operational_context": {
    "description": "Normalized live railway operational context from RailKit",
    "input_fields": {
      "train_number": "string",
      "journey_date": "string",
      "current_station_code": "string",
      "total_stations": "integer",
      "upcoming_station_count": "integer",
      "stoppage_count": "integer",
      "intermediate_station_count": "integer",
      "current_distance_km": "number|null",
      "max_observed_delay_minutes": "number",
      "average_observed_delay_minutes": "number",
      "has_delay": "boolean"
    },
    "derived_features": {
      "railkit_delay_risk": "number[0,1]",
      "railkit_operational_pressure": "number[0,1]",
      "railkit_data_available": "integer[0,1]"
    }
  }
}
